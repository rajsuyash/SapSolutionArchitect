# Local development only. These PUBLIC example credentials are not production secrets.
# Services: docker compose up -d --wait
# Tests: pnpm test:infra
# The integration tests provision the local bucket idempotently.
# Copy to .env for application development; generate a new AUTH_SECRET for deployments.
# Web/worker startup validation and deployment provisioning are wired in later M0 phases.
DATABASE_URL=postgresql://sap_pm:sap-pm-local-only@127.0.0.1:55417/sap_pm
APP_URL=http://127.0.0.1:3017
AUTH_SECRET=local-dev-only-replace-before-deployment-32
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
# AI_PROVIDER is stub, anthropic or deepinfra (the Anthropic-compatible endpoint at api.deepinfra.com/anthropic).
# deepinfra needs DEEPINFRA_API_KEY and AI_MODEL=XiaomiMiMo/MiMo-V2.6-Flash (anthropic: AI_MODEL=claude-sonnet-5-5).
# AI_MODEL_DESIGN (optional) is the model for the long To-Be design stage only; unset means AI_MODEL runs every stage.
# Recommended on deepinfra: AI_MODEL=XiaomiMiMo/MiMo-V2.6-Flash AI_MODEL_DESIGN=XiaomiMiMo/MiMo-V2.6-Pro
DEEPINFRA_API_KEY=
# AI_MODEL defaults to claude-sonnet-5-5; AI_MAX_INPUT_TOKENS to 60000;
# AI_MAX_CONCURRENCY to 4. The To-Be stage needs AI_MAX_INPUT_TOKENS of about 45000 or more.
# CONSULTANT_DAILY_JOB_LIMIT caps consultant jobs per organization per rolling 24 hours (default 200).
# AI time budgets in whole seconds (defaults shown; sized for Claude). Per-call timeouts must not exceed the stage budget.
# For a slow model such as MiMo-V2.6-Pro on DeepInfra (~12 output tokens/s measured) use:
# AI_STAGE_BUDGET_SECONDS=1200 AI_CALL_TIMEOUT_SECONDS=300 AI_DESIGN_CALL_TIMEOUT_SECONDS=1000
# AI_STAGE_BUDGET_SECONDS=300       (60-1800) whole stage including repair attempts
# AI_CALL_TIMEOUT_SECONDS=120       (30-1500) one model call, ordinary stages
# AI_DESIGN_CALL_TIMEOUT_SECONDS=240 (30-1500) one model call, the long To-Be design stage
# AI_NO_THINKING_STAGES (optional, comma-separated: problem_analysis, interview_turn, to_be) turns model reasoning off for those stages,
# DeepInfra only (sends thinking: {type: disabled}); anthropic is refused because Claude answers 400. Recommended on deepinfra with MiMo:
# AI_NO_THINKING_STAGES=interview_turn
# AI_FAULT_INJECTION is off by default.
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
EMAIL_FROM=sap-pm@example.test
S3_ENDPOINT=http://127.0.0.1:19017
S3_REGION=us-east-1
S3_BUCKET=sap-pm-local
S3_ACCESS_KEY_ID=sap-pm-local
S3_SECRET_ACCESS_KEY=sap-pm-local-storage-only
# Optional "Continue with Google" sign-in: set BOTH or neither (a half-set pair fails startup).
# Create an OAuth client (type: Web application) and add ${APP_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform admin (/admin): comma-separated sign-in emails of SaaS operators, matched case-insensitively.
# Empty or unset means nobody is a platform admin. This is separate from a workspace's ADMIN role.
PLATFORM_ADMIN_EMAILS=
# Cost estimate on /admin, USD per million tokens. Defaults are Claude Sonnet 5.5's list price (2 input / 10 output).
# Leave unset for the defaults; adjust if the model or your contract price changes.
# AI_PRICE_INPUT_USD_PER_MTOK=2
# AI_PRICE_OUTPUT_USD_PER_MTOK=10
# AI_MODEL_PRICES (optional JSON, model id -> [input, output] USD per M tokens, each > 0 and <= 1000) prices each job by the model
# recorded in its metrics; models without an entry and older jobs use the two prices above. Recommended on deepinfra:
# AI_MODEL_PRICES={"XiaomiMiMo/MiMo-V2.6-Flash":[0.14,0.28],"XiaomiMiMo/MiMo-V2.6-Pro":[0.43,0.87]}
