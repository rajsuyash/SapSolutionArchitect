# Local development only. These PUBLIC example credentials are not production secrets.
# Services: docker compose up -d --wait
# Tests: pnpm test:infra
# The integration tests provision the local bucket idempotently.
# Copy to .env for application development; generate a new AUTH_SECRET for deployments.
# Web/worker startup validation and deployment provisioning are wired in later M0 phases.
DATABASE_URL=postgresql://sap_pm:sap-pm-local-only@127.0.0.1:55417/sap_pm
APP_URL=http://127.0.0.1:3017
AUTH_SECRET=local-dev-only-replace-before-deployment-32
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
# AI_MODEL defaults to claude-sonnet-5-5; AI_MAX_INPUT_TOKENS to 60000;
# AI_MAX_CONCURRENCY to 4. AI_FAULT_INJECTION is off by default.
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
EMAIL_FROM=sap-pm@example.test
S3_ENDPOINT=http://127.0.0.1:19017
S3_REGION=us-east-1
S3_BUCKET=sap-pm-local
S3_ACCESS_KEY_ID=sap-pm-local
S3_SECRET_ACCESS_KEY=sap-pm-local-storage-only
